rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Admin Emails (allowlist) ──────────────────────────────────────────
    match /adminEmails/{email} {
      // Authenticated users can read any adminEmails doc (to check their own status)
      allow read: if request.auth != null;
      // Authenticated users can create their own request doc
      allow create: if request.auth != null
                    && request.auth.token.email.lower() == email;
      // Only approved admins can update/delete (approve or remove others)
      allow update, delete: if request.auth != null
                            && isApprovedAdmin(request.auth.token.email);
    }

    // ── All other collections ─────────────────────────────────────────────
    // Authenticated admins can read/write everything else
    match /{document=**} {
      allow read, write: if request.auth != null
                         && isApprovedAdmin(request.auth.token.email);
    }

    // ── Helper: check if caller is an approved admin ──────────────────────
    function isApprovedAdmin(email) {
      return exists(/databases/$(database)/documents/adminEmails/$(email.lower()))
          && get(/databases/$(database)/documents/adminEmails/$(email.lower())).data.approved == true;
    }
  }
}
